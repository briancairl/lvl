diff --git a/include/nlohmann/detail/meta/type_traits.hpp b/include/nlohmann/detail/meta/type_traits.hpp
index d834a0d..1aca427 100644
--- a/include/nlohmann/detail/meta/type_traits.hpp
+++ b/include/nlohmann/detail/meta/type_traits.hpp
@@ -9,6 +9,7 @@
 #pragma once
 
 #include <limits> // numeric_limits
+#include <memory> // allocator_traits (GFT patch)
 #include <string> // char_traits
 #include <tuple> // tuple
 #include <type_traits> // false_type, is_constructible, is_integral, is_same, true_type
@@ -47,6 +48,14 @@ namespace detail
 // In this case, T has to be properly CV-qualified to constraint the function arguments
 // (e.g. to_json(BasicJsonType&, const T&))
 
+// GFT patch: the parser/serializer's own working buffers use the JSON type's allocator (rebound to
+// their element type) instead of always std::allocator, so a basic_json with a custom AllocatorType
+// (e.g. an arena) does no other heap allocation while parsing or dumping. Identical for the default
+// std::allocator.
+template<typename BasicJsonType, typename T>
+using json_rebound_allocator_t =
+    typename std::allocator_traits<typename BasicJsonType::allocator_type>::template rebind_alloc<T>;
+
 template<typename> struct is_basic_json : std::false_type {};
 
 NLOHMANN_BASIC_JSON_TPL_DECLARATION
